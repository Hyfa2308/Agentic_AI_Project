# ==============================================
# AssistIQ Environment Configuration
# ==============================================
# Copy this file to .env and configure environment parameters.
# NEVER commit sensitive API keys to version control.

# --- Execution Engine Mode ---
# Choices: "mock" (deterministic testing without API keys) or "production" (live LLM)
AI_MODE=mock

# --- LLM Configuration ---
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# --- Database ---
# PostgreSQL (default) with automatic fallback to local SQLite (sqlite:///./assistiq.db)
DATABASE_URL=postgresql://assistiq_user:assistiq_pass@localhost:5432/assistiq_db

# --- ChromaDB Vector Store ---
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=assistiq_knowledge

# --- Embedding Model ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Application Settings ---
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO
