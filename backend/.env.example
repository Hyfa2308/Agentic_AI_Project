# ==============================================
# AssistIQ Backend Configuration
# ==============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# --- LLM Configuration ---
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# --- PostgreSQL ---
DATABASE_URL=postgresql://assistiq_user:assistiq_pass@localhost:5432/assistiq_db

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=assistiq_knowledge

# --- Embedding Model ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Application ---
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
